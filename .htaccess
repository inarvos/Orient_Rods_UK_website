Options -MultiViews
RewriteEngine On

# Revalidate pages and front-end files after an upload so browsers do not keep
# an older logo or layout. Versioned asset URLs provide a second cache break.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|css|js|json)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# VekTra now has one clean canonical product URL.
RewriteRule ^vektra-13/?$ /vektra [R=301,L]

# Keep real files and folders (assets, JavaScript, images) untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Clean catalogue pages.
RewriteRule ^rods/?$ catalogue.html?route=rods [L,QSA]

# Withdrawn feeder Distance products and their old series URLs return to the current feeder range.
RewriteRule ^(?:chameleon-distance-feeder|chameleon-distance-d2|chameleon-distance-feeder-14-35oz|chameleon-distance-d2-14-36oz)/?$ /rods/feeder-rods [R=301,L]
RewriteRule ^rods/feeder-rods/chameleon-distance(?:/.*)?/?$ /rods/feeder-rods [R=301,L]

# Series that have one primary model redirect to their canonical product URL.
RewriteRule ^rods/carp-fishing-rods/astra-series/?$ /astra [R=301,L]
RewriteRule ^rods/carp-fishing-rods/vektra/?$ /vektra [R=301,L]
RewriteRule ^rods/carp-fishing-rods/inventa/?$ /inventa [R=301,L]
RewriteRule ^rods/carp-fishing-rods/iva-series/?$ /iva-37 [R=301,L]
RewriteRule ^rods/carp-fishing-rods/distance/?$ /distance [R=301,L]
RewriteRule ^rods/feeder-rods/chameleon-ultimate/?$ /chameleon-ultimate-feeder [R=301,L]
RewriteRule ^rods/feeder-rods/chameleon-fx/?$ /chameleon-fx [R=301,L]
RewriteRule ^rods/seafishing-rods/amphitrite/?$ /amphitrite [R=301,L]
RewriteRule ^rods/casting-rods/bestia-casting/?$ /bestia-casting [R=301,L]

# Variant selection cards always lead to their final product pages.
RewriteRule ^rods/carp-fishing-rods/bestia-series/vc/?$ /bestia-vc [R=301,L]
RewriteRule ^rods/carp-fishing-rods/bestia-series/pp/?$ /bestia-pp [R=301,L]
RewriteRule ^rods/carp-fishing-rods/venus-series/v2/?$ /v2 [R=301,L]
RewriteRule ^rods/carp-fishing-rods/venus-series/v3/?$ /v3 [R=301,L]
RewriteRule ^rods/carp-fishing-rods/galax-series/galax/?$ /galax [R=301,L]
RewriteRule ^rods/carp-fishing-rods/galax-series/galax-sd/?$ /galax-sd [R=301,L]
RewriteRule ^rods/carp-fishing-rods/iva-series/37lb/?$ /iva-37 [R=301,L]
RewriteRule ^rods/carp-fishing-rods/chameleon-series/ultimate/?$ /chameleon-ultimate [R=301,L]
RewriteRule ^rods/carp-fishing-rods/chameleon-series/s1-s2/?$ /chameleon-s1-s2 [R=301,L]
RewriteRule ^rods/carp-fishing-rods/chameleon-series/sm/?$ /chameleon-sm [R=301,L]
RewriteRule ^rods/(.+)/?$ catalogue.html?route=rods/$1 [L,QSA]
RewriteRule ^throwing-sticks/?$ catalogue.html?route=throwing-sticks [L,QSA]
RewriteRule ^contact/?$ contact.html [L,QSA]

# Clean product pages, for example /v2 and /bestia-casting.
RewriteRule ^([a-z0-9-]+)/?$ product.html?route=$1 [L,QSA]
